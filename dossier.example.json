{
  "workspaceRoot": "~/workspace",
  "personalRules": "~/.dossier/personal.md",
  "sharedSkills": [],
  "agents": {
    "source": "~/.dossier/agents",
    "roles": { "lead": "my-lead", "builder": "my-builder", "reviewer": "my-reviewer", "researcher": "my-researcher", "hr": "my-hr" }
  },
  "firm": {
    "key": "firm",
    "name": "Your Firm",
    "hubRoot": "~/workspace/hub",
    "sandboxRoot": "~/workspace/sandbox",
    "expectEmail": "you@yourfirm.example",
    "expectOrg": "<your firm org uuid>"
  },
  "clients": [
    {
      "key": "acme",
      "name": "Acme Health",
      "root": "~/workspace/clients/acme",
      "seat": "enterprise",
      "expectEmail": "you@acme.example.com",
      "expectOrg": "<acme org uuid>",
      "formerRoots": ["~/workspace/acme-old-checkout"],
      "contacts": ["Product: Jane Doe"],
      "status": "active"
    },
    {
      "key": "widgetco",
      "name": "WidgetCo",
      "root": "~/workspace/clients/widgetco",
      "seat": "none",
      "expectEmail": "you@yourfirm.example",
      "basedOn": ["base-app"],
      "repos": [{ "remote": "git@github.com:widgetco/widget-app.git",
                  "from": { "product": "base-app", "repo": "base-app" } }],
      "status": "active"
    }
  ],
  "products": [
    {
      "key": "base-app",
      "name": "Base App",
      "root": "~/workspace/products/base-app",
      "clientRead": ["base-app"],
      "enterpriseRead": false,
      "repos": [{ "remote": "git@github.com:yourfirm/base-app.git" }],
      "status": "active"
    }
  ]
}
